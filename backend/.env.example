# Values are examples/placeholders. Do not commit real secrets or runtime data.
DIVIDRUK_HOST=127.0.0.1
DIVIDRUK_PORT=8080
DIVIDRUK_TEST_MODE=1
# Set a unique random token of at least 24 characters in the process environment.
DIVIDRUK_ADMIN_TOKEN=
# Optional private absolute database path. Default: backend/runtime/3dividruk.sqlite3
DIVIDRUK_DB_PATH=
# Optional: unique Nova Poshta key for this shop; lookup only, no TTN creation.
DIVIDRUK_NOVA_POSHTA_API_KEY=
# Empty means same-origin only. Add explicit own origins only when needed.
DIVIDRUK_CORS_ORIGINS=
